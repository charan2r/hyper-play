# Runtime
PORT=5000
NODE_ENV=development

# PostgreSQL
# For local npm development:
DATABASE_URL=postgresql://postgres:change_this_password@localhost:5432/sports

# Redis / BullMQ notification outbox
REDIS_URL=redis://localhost:6379
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
NOTIFICATION_WORKER_CONCURRENCY=5
# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Browser origins allowed by CORS 
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Amazon S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=replace_me
AWS_SECRET_KEY=replace_me
AWS_BUCKET_NAME=replace_me
